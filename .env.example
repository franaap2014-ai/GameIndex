NODE_ENV=development
PERFORMANCE_MODE=true
DEV_TOOLS=false
AI_MODE=LOCAL_FIRST
OLLAMA_ENABLED=true
OLLAMA_MODEL=gemma3:4b
MAX_CONCURRENT_AI_TASKS=1
GAMEINDEX_BACKGROUND_WORKERS=false
GAMEINDEX_IMAGE_REPAIR_WORKER=false
GAMEINDEX_STARTUP_VISUAL_SCAN=false

# Optional: email 2FA. Leave blank when not used.
GAMEINDEX_SMTP_HOST=
GAMEINDEX_SMTP_PORT=587
GAMEINDEX_SMTP_SECURE=false
GAMEINDEX_SMTP_USER=
GAMEINDEX_SMTP_PASS=
GAMEINDEX_SMTP_FROM=

# Beta 0.987: keep a bounded number of verified migration backups.
GAMEINDEX_DB_BACKUP_RETENTION=5

# Beta 0.991 HF1: first-owner bootstrap. Use a long one-time value and remove/rotate it after setup.
GAMEINDEX_SETUP_CODE=

# Persistent storage. Required on hosts with ephemeral filesystems.
# On Render with an attached Persistent Disk, point this to the disk mount (for example /var/data/GameIndex).
GAMEINDEX_DATA_DIR=
# Or set the exact SQLite file path instead of GAMEINDEX_DATA_DIR.
GAMEINDEX_DB=

# Optional migration cap. Leave blank to use the current release target (schema 42).
GAMEINDEX_TARGET_SCHEMA=42

# Production safety escape hatch. Do not enable in real production.
GAMEINDEX_ALLOW_EPHEMERAL_PRODUCTION=false
