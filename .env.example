NODE_ENV=development
PERFORMANCE_MODE=true
DEV_TOOLS=false
AI_MODE=LOCAL_FIRST
OLLAMA_ENABLED=true
OLLAMA_MODEL=gemma3:4b
MAX_CONCURRENT_AI_TASKS=1
GAMEINDEX_BACKGROUND_WORKERS=false
GAMEINDEX_IMAGE_REPAIR_WORKER=false
GAMEINDEX_STARTUP_VISUAL_SCAN=false

# Optional: email 2FA. Leave blank when not used.
GAMEINDEX_SMTP_HOST=
GAMEINDEX_SMTP_PORT=587
GAMEINDEX_SMTP_SECURE=false
GAMEINDEX_SMTP_USER=
GAMEINDEX_SMTP_PASS=
GAMEINDEX_SMTP_FROM=

# Beta 0.987: keep a bounded number of verified migration backups.
GAMEINDEX_DB_BACKUP_RETENTION=5

# Beta 0.991 HF1: first-owner bootstrap. Use a long one-time value and remove/rotate it after setup.
GAMEINDEX_SETUP_CODE=

# Beta 0.991 I1 HF1 persistent production storage.
# Render Free has an ephemeral filesystem, so production should use the external Neon database.
# Keep DATABASE_URL secret in the deployment environment. Never commit a real connection string.
DATABASE_URL=

# Optional local-development / non-Render filesystem storage.
# On Render these values NEVER count as persistent storage; production persistence must come from Neon DATABASE_URL.
GAMEINDEX_DATA_DIR=
GAMEINDEX_DB=

# Remote SQLite snapshot tuning for Neon. Defaults are appropriate for the current GameIndex database.
GAMEINDEX_REMOTE_SNAPSHOT_KEY=production
GAMEINDEX_REMOTE_SNAPSHOT_CHUNK_BYTES=524288
GAMEINDEX_REMOTE_SNAPSHOT_MAX_MB=64
GAMEINDEX_REMOTE_SNAPSHOT_KEEP=2
GAMEINDEX_REMOTE_SNAPSHOT_DELAY_MS=1200
GAMEINDEX_REMOTE_SNAPSHOT_WATCH_MS=2500

# Optional migration cap. Leave blank to use the current release target (schema 43).
GAMEINDEX_TARGET_SCHEMA=43

# Production safety escape hatch. Do not enable in real production.
GAMEINDEX_ALLOW_EPHEMERAL_PRODUCTION=false
